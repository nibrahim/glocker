# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

do_token     = "dop_v1_your_token_here"
ssh_key_name = "my-laptop"   # exact name of an SSH key in your DO account
region       = "blr1"
project_name = "Personal"

# Lock SSH to your own address if you can:
# ssh_source_addresses = ["203.0.113.4/32"]

# DNS: only if the zone lives on DigitalOcean. Otherwise leave manage_dns = false
# and point an A record at the droplet_ip output yourself.
# manage_dns = true
# dns_zone   = "example.com"
# dns_record = "peek"
