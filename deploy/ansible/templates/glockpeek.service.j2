# Managed by Ansible.
[Unit]
Description=glockpeek dashboard (hosted)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=glockpeek
Group=glockpeek
ExecStart=/usr/local/bin/glockpeek
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening — glockpeek needs no privileges, only its Postgres DSN.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/glockpeek

[Install]
WantedBy=multi-user.target
